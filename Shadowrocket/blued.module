#!url=https://raw.githubusercontent.com/HerbertGao/Scripts/dev/Shadowrocket/blued.module
#!name= Blued闪照
#!desc= Blued闪照转通知
#!category=HerbertGao's Scripts

[Rule]
URL-REGEX,^https://argo\.blued\.cn/blued/promote.*,REJECT
URL-REGEX,^https://argo\.blued\.cn/blued/adms/.*,REJECT
URL-REGEX,^https://argo\.blued\.cn/blued/splash.*,REJECT
URL-REGEX,^https://argo\.blued\.cn/blued/launch/adms,REJECT
URL-REGEX,^https://social\.blued\.cn/users/.*/joy,REJECT
URL-REGEX,^https://social\.blued\.cn/users/recommend,REJECT
URL-REGEX,^https://voice\.irisgw\.cn/users/chatroom,REJECT

[Script]
Blued闪照 = type=http-response,pattern=^https:\/\/(burn-chatfiles)\.bldimg\.(com|cn)\/.*\/(ingfiles|burn_chatfiles\/(videos|users))\/.*,requires-body=0,max-size=0,debug=0,script-path=https://raw.githubusercontent.com/HerbertGao/Scripts/dev/Scripts/Blued/blued.js,script-update-interval=0

[MITM]
hostname = %APPEND% social.blued.cn,argo.blued.cn,*.bldimg.com,*.bldimg.cn,voice.irisgw.cn