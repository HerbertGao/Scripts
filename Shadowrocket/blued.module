#!url=https://raw.githubusercontent.com/HerbertGao/Scripts/dev/Surge/blued.module
#!name= Blued闪照
#!desc= Blued闪照转通知

[Script]
Blued闪照 = type=http-response,pattern=^https:\/\/(www|burn-chatfiles)\.bldimg\.com\/(ingfiles|burn_chatfiles\/(videos|users))\/.*(mp4|jpg|(jpg|png)).*,requires-body=0,max-size=0,debug=0,script-path=https://raw.githubusercontent.com/HerbertGao/Scripts/dev/Scripts/Blued/blued.js,script-update-interval=0
Blued-VIP = type=http-response,pattern=https://((social|argo).blued.cn|\b((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\b)/users/.*,requires-body=1,max-size=0,binary-body-mode=0,script-path=https://gist.githubusercontent.com/Alex0510/425ac5e1523ceab4756387c719430e42/raw/cb59df53dcc45101c521f07d1746e8ee08fb65ce/blued_vip.js,script-update-interval=0

[MITM]
hostname =  %APPEND% social.blued.cn,argo.blued.cn,<ip-address>,burn-chatfiles.bldimg.com,-blued.irisdt.cn,-120.53.131.149,-live-im.blued.cn,-h*.blued.cn,-95.161.76.101,-101.23.128.20,-129.226.78.144,-112.28.199.148,-120.53.131.149
