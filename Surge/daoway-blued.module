#!url=https://raw.githubusercontent.com/HerbertGao/Scripts/dev/Surge/daoway-blued.module
#!name= 到位×Blued 匹配
#!desc= 打开到位技师主页，后台匹配 Blued 附近的人并推送。需开启 MITM 和 Surge HTTP API、填写模块参数，并先打开一次 Blued 附近的人。
#!category=HerbertGao's Scripts
#!arguments = HTTP_API:""
#!arguments-desc = HTTP_API: 必填，填 Surge HTTP API 密码，默认端口 6171；其他端口填 密码@127.0.0.1:端口。密码勿含 @、逗号或引号。

[Rule]
URL-REGEX,^https:\/\/api\.daoway\.cn\/daoway\/rest\/technician\/v2\/\d+\/by_buyer,DIRECT
URL-REGEX,^https:\/\/social\.irisgw\.cn\/users\?,DIRECT

[Script]
到位坐标缓存 = type=http-request, pattern=^https:\/\/api\.daoway\.cn\/daoway\/rest\/technician\/v2\/\d+\/by_buyer(?:\?.*)?$, script-path=https://raw.githubusercontent.com/HerbertGao/Scripts/dev/Scripts/Daoway/daoway-blued.js?v=23
到位点击触发 = type=http-request, pattern=^https:\/\/api\.daoway\.cn\/daoway\/rest\/technician\/\d+\/click(?:\?.*)?$, script-path=https://raw.githubusercontent.com/HerbertGao/Scripts/dev/Scripts/Daoway/daoway-blued.js?v=23, argument=HTTP_API="{{{HTTP_API}}}"
Blued凭证缓存 = type=http-request, pattern=^https:\/\/social\.irisgw\.cn\/users(?:\?.*)?$, script-path=https://raw.githubusercontent.com/HerbertGao/Scripts/dev/Scripts/Daoway/daoway-blued.js?v=23

[MITM]
hostname = %APPEND% api.daoway.cn,social.irisgw.cn
