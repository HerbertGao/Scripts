name: 圣魔闪照保存
desc: 圣魔闪照转快捷指令保存

http:
  mitm:
    - "shengmo2.oss-cn-shanghai.aliyuncs.com"
    - "image.oss2.aiwujie.com.cn"
  script:
    - match: ^http:\/\/shengmo2\.oss-cn-shanghai\.aliyuncs\.com\/Uploads\/Fastphoto\/
      name: shengmo.save.js
      type: response
      require-body: true
    - match: ^https?:\/\/image\.oss2\.aiwujie\.com\.cn\/Uploads\/Fastphoto\/
      name: shengmo.save.js
      type: response
      require-body: true

script-providers:
  shengmo.save.js:
    url: https://raw.githubusercontent.com/HerbertGao/Scripts/dev/Scripts/Shengmo/shengmo.save.js
    interval: 86400
