name: Blued闪照保存
desc: Blued闪照转快捷指令保存

http:
  mitm:
    - "*burn-chatfiles.bldimg.com"
    - "*burn-chatfiles.bldimg.cn"
    - "*burnchatfiles*.bldimg.com"
    - "*burnchatfiles*.bldimg.cn"
    - "argo.blued.cn"
    - "social.blued.cn"
    - "social.irisgw.cn"
    - "moments.irisgw.cn"
    - "voice.irisgw.cn"
  url-rewrite:
    - ^https://(?:argo\.blued\.cn|moments\.irisgw\.cn)/blued/(?:promote.*|adms/.*|splash.*|launch/adms(?:\?.*)?|promotion/banners(?:\?.*)?|floats(?:\?.*)?|api/ad/distribution(?:\?.*)?)$ - reject
    - ^https://(?:social\.blued\.cn|social\.irisgw\.cn)/users/.*/joy(?:\?.*)?$ - reject
    - ^https://(?:social\.blued\.cn|social\.irisgw\.cn)/users/(?:recommend|selection)(?:\?.*)?$ - reject
    - ^https://voice\.irisgw\.cn/users/chatroom.* - reject
    - ^https://social\.irisgw\.cn/voice-chat/api/.* - reject
  script:
    - match: ^https:\/\/(burn-chatfiles)\.bldimg\.(com|cn)\/.*\/(ingfiles|burn_chatfiles\/(videos|users))\/.*\.(mp4|jpg|png).*
      name: blued.save.js
      type: response
      require-body: true
    - match: ^https:\/\/.*burnchatfiles.*\.bldimg\.(com|cn)\/burn_chatfiles\/(users|videos)\/.*\.(mp4|jpg|png).*
      name: blued.save.js
      type: response
      require-body: true
    - match: ^https:\/\/(?:argo\.blued\.cn|social\.irisgw\.cn)\/users\/\d+(\?|$)
      name: blued.profile.js
      type: response
      require-body: true

script-providers:
  blued.save.js:
    url: https://raw.githubusercontent.com/HerbertGao/Scripts/dev/Scripts/Blued/blued.save.js
    interval: 86400
  blued.profile.js:
    url: https://raw.githubusercontent.com/HerbertGao/Scripts/dev/Scripts/Blued/blued.profile.js
    interval: 86400
