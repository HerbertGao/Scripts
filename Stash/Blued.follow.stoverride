name: Blued关注列表
desc: 打开自己的主页时，关注数变了就拉完整名单；只有变少才通知是谁，带该人头像，点击跳进主页。消失不等于封号或注销，也可能是取关。

http:
  mitm:
    - "social.irisgw.cn"
  script:
    - match: ^https:\/\/social\.irisgw\.cn\/users\/\d+$
      name: blued.follow.js
      type: response
      require-body: true

script-providers:
  blued.follow.js:
    url: https://raw.githubusercontent.com/HerbertGao/Scripts/dev/Scripts/Blued/blued.follow.js
    interval: 86400
